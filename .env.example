# Required: Full Cookie header from notebook.google.com (Chrome DevTools -> Network -> batchexecute)
NOTEBOOKLM_COOKIES=

# Optional: Interface / artifact language (default: en)
NOTEBOOKLM_HL=en

# Remote HTTP MCP server settings
NOTEBOOKLM_MCP_TRANSPORT=http
NOTEBOOKLM_MCP_HOST=0.0.0.0
NOTEBOOKLM_MCP_PORT=8000
NOTEBOOKLM_MCP_PATH=/mcp
NOTEBOOKLM_MCP_STATELESS=true
